import { useState, useEffect } from "react";
import { Link } from "react-router-dom";
import { supabase } from "@/lib/supabase";
import { useLanguage } from "@/contexts/LanguageContext";
import { useAuth } from "@/contexts/AuthContext";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { MessageSquare, PlusCircle, Calendar, Clock, User, FileText } from "lucide-react";
import ScrollReveal from "@/components/ScrollReveal";
import TopicListItem from "@/components/forum/TopicListItem";
import ForumTroubleshootingBanner from "@/components/forum/ForumTroubleshootingBanner";

interface Category {
  id: string;
  name: string;
  name_ar?: string;
  description?: string;
  description_ar?: string;
  topic_count?: number;
  recent_topics?: Topic[];
}

interface Topic {
  id: string;
  title: string;
  content: string;
  created_at: string;
  user_id: string;
  category_id: string;
  view_count?: number;
  comment_count?: number;
  profiles?: {
    username?: string;
    avatar_url?: string;
    email?: string;
  };
  forum_categories?: {
    name: string;
    name_ar?: string;
  };
}

const Forum = () => {
  const { t, lang } = useLanguage();
  const { user } = useAuth();
  const [categories, setCategories] = useState<Category[]>([]);
  const [recentTopics, setRecentTopics] = useState<Topic[]>([]);
  const [popularTopics, setPopularTopics] = useState<Topic[]>([]);
  const [categoryTopics, setCategoryTopics] = useState<{[key: string]: Topic[]}>({});
  const [loading, setLoading] = useState(true);

  // Fetch forum data on component mount
  useEffect(() => {
    async function fetchForumData() {
      setLoading(true);
      
      try {
        console.log('Fetching forum data with optimized loading...');
        
        // Use the optimized forum data loader
        const { loadForumData } = await import('@/lib/forumDataLoader');
        
        try {
          // Load all forum data in an optimized way
          const forumData = await loadForumData();
          
          // Set state with the optimized data
          setCategories(forumData.categories);
          setRecentTopics(forumData.recentTopics);
          setPopularTopics(forumData.popularTopics);
          setCategoryTopics(forumData.categoryTopics);
          
          console.log('Forum data loaded successfully');
        } catch (dataError) {
          console.error('Error loading forum data:', dataError);
          
          // Even if there's an error, try to show at least the categories
          try {
            const { data: categoriesData } = await supabase
              .from('forum_categories')
              .select('*')
              .order('name', { ascending: true });
            
            if (categoriesData && categoriesData.length > 0) {
              setCategories(categoriesData);
            }
          } catch (fallbackErr) {
            console.error('Failed to recover with categories-only query:', fallbackErr);
          }
        }
      } catch (error) {
        console.error('Error in fetchForumData:', error);
      } finally {
        setLoading(false);
      }
    }

    fetchForumData();
  }, []);

  // Format date for display
  const formatDate = (dateString: string) => {
    const date = new Date(dateString);
    return new Intl.DateTimeFormat(lang === 'ar' ? 'ar-SA' : 'en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    }).format(date);
  };

  return (
    <div className="container py-8" dir={lang === "ar" ? "rtl" : "ltr"}>
      <ScrollReveal initiallyVisible={true}>
        <ForumTroubleshootingBanner isError={loading && categories.length === 0} />
        <div className="flex justify-between items-center mb-8">
          <div>
            <h1 className="text-3xl font-bold">{t("Community Forum", "منتدى المجتمع")}</h1>
            <Link to="/forum/debug" className="text-sm text-muted-foreground hover:underline">
              {t("Forum Diagnostics", "تشخيص المنتدى")}
            </Link>
          </div>
          {user && (
            <Button asChild>
              <Link to="/forum/new-topic">
                <PlusCircle className="mr-2 h-4 w-4" />
                {t("New Topic", "موضوع جديد")}
              </Link>
            </Button>
          )}
        </div>
      </ScrollReveal>

      {/* Forum description */}
      <ScrollReveal delay={0.1}>
        <div className="bg-muted p-4 rounded-lg mb-8">
          <p>
            {t(
              "Welcome to our Solar Energy Community Forum. Share knowledge, ask questions, and connect with other solar enthusiasts.",
              "مرحبًا بك في منتدى مجتمع الطاقة الشمسية. شارك المعرفة، واطرح الأسئلة، وتواصل مع المهتمين الآخرين بالطاقة الشمسية."
            )}
          </p>
          {!user && (
            <p className="mt-2">
              {t(
                "Please sign in to create new topics or reply to discussions.",
                "يرجى تسجيل الدخول لإنشاء مواضيع جديدة أو الرد على المناقشات."
              )}
            </p>
          )}
        </div>
      </ScrollReveal>
      
      {/* Forum Tabs */}
      <Tabs defaultValue="categories" className="mb-8">
        <TabsList className="mb-4">
          <TabsTrigger value="categories">{t("Categories", "الفئات")}</TabsTrigger>
          <TabsTrigger value="recent">{t("Recent Discussions", "المناقشات الأخيرة")}</TabsTrigger>
          <TabsTrigger value="popular">{t("Popular Topics", "المواضيع الشائعة")}</TabsTrigger>
        </TabsList>
        
        {/* Categories Tab */}
        <TabsContent value="categories">
          {loading ? (
            <div className="flex items-center justify-center h-40">
              <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
            </div>
          ) : (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              {categories.length === 0 ? (
                <p className="text-center text-muted-foreground col-span-2">
                  {t("No categories found.", "لم يتم العثور على فئات.")}
                </p>
              ) : (
                categories.map((category) => (
                  <ScrollReveal key={category.id} delay={0.1} className="h-full">
                    <Card className="h-full">
                      <CardHeader>
                        <CardTitle>
                          <Link 
                            to={`/forum/category/${category.id}`}
                            className="hover:text-primary transition-colors"
                          >
                            {lang === "ar" && category.name_ar ? category.name_ar : category.name}
                          </Link>
                        </CardTitle>
                        <CardDescription>
                          {lang === "ar" && category.description_ar ? category.description_ar : category.description}
                        </CardDescription>
                        <Badge variant="secondary" className="mt-2">
                          {t("Topics: ", "المواضيع: ")} {category.topic_count || 0}
                        </Badge>
                      </CardHeader>
                      <CardContent>
                        {category.recent_topics && category.recent_topics.length > 0 ? (
                          <div className="space-y-3">
                            <h4 className="text-sm font-medium">
                              {t("Recent Topics", "المواضيع الأخيرة")}
                            </h4>
                            {category.recent_topics.map((topic) => (
                              <div key={topic.id} className="border-b pb-2 last:border-0">
                                <Link 
                                  to={`/forum/topic/${topic.id}`}
                                  className="text-sm hover:text-primary transition-colors block truncate"
                                >
                                  {topic.title}
                                </Link>
                                <div className="flex items-center gap-4 mt-1">
                                  <span className="flex items-center text-xs text-muted-foreground">
                                    <User className="mr-1 h-3 w-3" />
                                    {topic.profiles?.username || topic.profiles?.email || t("Unknown User", "مستخدم غير معروف")}
                                  </span>
                                  <span className="flex items-center text-xs text-muted-foreground">
                                    <MessageSquare className="mr-1 h-3 w-3" />
                                    {topic.comment_count || 0}
                                  </span>
                                </div>
                              </div>
                            ))}
                            <Button variant="outline" size="sm" asChild className="w-full mt-2">
                              <Link to={`/forum/category/${category.id}`}>
                                {t("View All Topics", "عرض جميع المواضيع")}
                              </Link>
                            </Button>
                          </div>
                        ) : (
                          <p className="text-sm text-muted-foreground">
                            {t("No topics yet in this category.", "لا توجد مواضيع في هذه الفئة حتى الآن.")}
                          </p>
                        )}
                      </CardContent>
                    </Card>
                  </ScrollReveal>
                ))
              )}
            </div>
          )}
        </TabsContent>
        
        {/* Recent Topics Tab */}
        <TabsContent value="recent">
          {loading ? (
            <div className="flex items-center justify-center h-40">
              <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
            </div>
          ) : (
            <div className="space-y-4">
              {recentTopics.length === 0 ? (
                <p className="text-center text-muted-foreground">
                  {t("No recent topics found.", "لم يتم العثور على مواضيع حديثة.")}
                </p>
              ) : (
                recentTopics.map((topic, index) => (
                  <ScrollReveal key={topic.id} delay={0.05 * index}>
                    <TopicListItem 
                      topic={topic} 
                      formatDate={formatDate}
                      t={t}
                    />
                  </ScrollReveal>
                ))
              )}
            </div>
          )}
        </TabsContent>
        
        {/* Popular Topics Tab */}
        <TabsContent value="popular">
          {loading ? (
            <div className="flex items-center justify-center h-40">
              <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
            </div>
          ) : (
            <div className="space-y-4">
              {popularTopics.length === 0 ? (
                <p className="text-center text-muted-foreground">
                  {t("No popular topics found.", "لم يتم العثور على مواضيع شائعة.")}
                </p>
              ) : (
                popularTopics.map((topic, index) => (
                  <ScrollReveal key={topic.id} delay={0.05 * index}>
                    <TopicListItem 
                      topic={topic} 
                      formatDate={formatDate}
                      t={t}
                    />
                  </ScrollReveal>
                ))
              )}
            </div>
          )}
        </TabsContent>
      </Tabs>
    </div>
  );
};

export default Forum;
